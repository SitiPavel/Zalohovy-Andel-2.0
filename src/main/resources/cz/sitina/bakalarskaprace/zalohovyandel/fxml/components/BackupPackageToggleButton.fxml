<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cz.sitina.bakalarskaprace.zalohovyandel.controllers.components.BackupPackageToggleButtonController">
   <children>
      <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../images/visualObjects/package.png" />
         </image>
      </ImageView>
      <Label fx:id="lbName" alignment="CENTER" contentDisplay="CENTER" prefHeight="39.0" prefWidth="81.0" styleClass="WindowTitle_L1_Dark" text="přírůstek 1" textAlignment="CENTER" wrapText="true" />
      <Label fx:id="lbDate" alignment="CENTER" contentDisplay="CENTER" styleClass="WindowTitle_L1_Dark" text="20.3.2022" textAlignment="CENTER" wrapText="true" />
      <Label fx:id="lbTime" alignment="CENTER" contentDisplay="CENTER" styleClass="WindowTitle_L1_Dark" text="16:30" textAlignment="CENTER" wrapText="true" />
   </children>
   <stylesheets>
      <URL value="@../../css/compareOverviewStyl.css" />
      <URL value="@../../css/variables.css" />
      <URL value="@../../css/windowsStyle.css" />
      <URL value="@../../css/globlCss.css" />
   </stylesheets>
</VBox>
